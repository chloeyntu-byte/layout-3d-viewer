{
  "name": "layout-3d-viewer",
  "version": "1.1.0",
  "description": "Hierarchy-aware 3D layout viewer for JSON, GDSII, OASIS and (optionally) Virtuoso OA layouts.",
  "type": "module",
  "bin": {
    "vl3d": "./bin/vl3d"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "bin/vl3d",
    "vl3d.config.example.json",
    "docs/INSTALL.md",
    "docs/TROUBLESHOOTING.md",
    "requirements-native.txt",
    "native/*.py",
    "profiles/*.json",
    "public/index.html",
    "public/errors.html",
    "public/styles.css",
    "public/src/fallback.js",
    "public/src/model.js",
    "public/src/search-index.js",
    "public/src/viewer-next.js",
    "public/vendor/THREE-LICENSE.txt",
    "public/vendor/THREE-VERSION.txt",
    "public/vendor/three.core.min.js",
    "public/vendor/three.module.min.js",
    "tools/STREAM_IMPORT.md",
    "tools/build_release.mjs",
    "tools/build_stress_layout.py",
    "tools/convert_layout_tsv.py",
    "tools/error_catalog.mjs",
    "tools/export_layouts.sh",
    "tools/import_stream_layout.py",
    "tools/layout_catalog.mjs",
    "tools/library_sessions.mjs",
    "tools/oa_dump.il",
    "tools/pdk_profile.py",
    "tools/runtime_paths.mjs",
    "tools/server.mjs",
    "tools/klayout_macro.py",
    "tools/test_doctor.mjs",
    "tools/test_library_sessions.mjs",
    "tools/test_pdk_compat.py",
    "tools/test_runtime_paths.mjs",
    "tools/test_server_runtime.mjs",
    "tools/test_stream_import.py",
    "tools/verify_viewer.mjs",
    "tools/vl3d.mjs",
    "tests/backend/*.mjs",
    "tests/backend/*.py",
    "tests/native/*.py",
    "tests/test_ui_smoke.py",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "docs/USAGE.md",
    "docs/NET_TRACING_PLAN.md",
    "examples/*.json",
    "tools/make_example_inductor.py",
    "tools/test_release.mjs",
    "public/src/geometry.js",
    "tools/trace_service.mjs",
    "tools/trace_rules.py",
    "public/src/trace-client.js",
    "tools/annotate_pins.py",
    "docs/PIN_ANNOTATION.md",
    "tools/layout_units.py",
    "docs/LAYOUT_JSON.md",
    "tools/technology_layers.py",
    "docs/LAYER_PROFILES.md"
  ],
  "scripts": {
    "doctor": "node tools/vl3d.mjs doctor",
    "setup": "node tools/vl3d.mjs setup",
    "setup:native": "node tools/vl3d.mjs setup --native --install",
    "start": "node tools/vl3d.mjs gui",
    "gui": "node tools/vl3d.mjs gui",
    "web": "node tools/vl3d.mjs web",
    "export": "bash tools/export_layouts.sh",
    "build:stress": "python3 tools/build_stress_layout.py",
    "import:stream": "python3 tools/import_stream_layout.py",
    "serve": "node tools/server.mjs --root . --host 127.0.0.1 --port 5177 --enable-oa",
    "test": "npm run test:fast",
    "test:fast": "npm run test:node && npm run test:python",
    "test:node": "node tools/test_runtime_paths.mjs && node tools/test_library_sessions.mjs && node tools/test_doctor.mjs && node tools/test_server_runtime.mjs && node tests/backend/test_native_backend.mjs && node tests/backend/test_model.mjs && node tests/backend/test_geometry.mjs && node tools/test_release.mjs && node tests/backend/test_physical_trace_api.mjs && node tests/backend/test_trace_client.mjs && node tests/backend/test_pin_annotations_api.mjs && node tests/backend/test_layer_stack.mjs",
    "test:python": "npm run test:native && npm run test:pdk && npm run test:stream:preflight && python3 tests/backend/test_stream_import_gdstk.py && python3 tests/backend/test_layer_recognition.py && python3 tests/backend/test_trace_rules.py && python3 tests/backend/test_trace_metadata.py && python3 tests/backend/test_pin_annotations.py && python3 tests/backend/test_technology_layers.py && python3 tests/backend/test_profile_registry.py",
    "test:native": "python3 -m unittest discover -s tests/native -p 'test_*.py' && python3 -m unittest tests.test_ui_smoke",
    "test:pdk": "python3 tools/test_pdk_compat.py",
    "test:stream:preflight": "python3 tools/test_stream_import.py --preflight-only",
    "test:stream": "python3 tools/test_stream_import.py",
    "test:browser": "node tools/verify_viewer.mjs",
    "verify": "node tools/verify_viewer.mjs",
    "release:check": "node tools/build_release.mjs --check",
    "release:build": "node tools/build_release.mjs",
    "prepack": "node tools/build_release.mjs --check >/dev/null",
    "test:trace": "python3 -m unittest discover -s tests/native -p \"test_physical_trace*.py\" && node tests/backend/test_physical_trace_api.mjs",
    "test:trace:browser": "node tests/backend/test_physical_trace_browser.mjs",
    "test:ux:browser": "node tests/backend/test_viewer_ux_browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  },
  "license": "MIT"
}
